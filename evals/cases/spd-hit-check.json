    {"id": "infinite-accuracy", "label": "命中值达到无限则必中",
     "any": ["INFINITE_ACCURACY", "无限命中", "必中", "必定命中"]},
    {"id": "acc-roll", "label": "在 0 到命中值之间掷命中骰",
