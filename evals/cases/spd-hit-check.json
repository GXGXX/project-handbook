    {"id": "acc-multi", "label": "技能或魔法的命中倍率 accMulti",
     "any": ["accMulti", "魔法"]},
    {"id": "compare", "label": "命中骰 ≥ 闪避骰即命中，相等也算命中",
     "any": [">=", "≥", "大于等于", "不小于", "不低于"]}
  ],
  "decisions": ["infinite-evasion", "infinite-accuracy", "compare"],
  "order": [
    {"before": "skills", "after": "infinite-evasion", "why": "先取两边数值，再看是否无限"},
