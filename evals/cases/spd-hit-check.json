    {"file": "core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/actors/Char.java", "lines": "615-617",
     "note": "魔法攻击的三参数重载把 accMulti 设为 2"}
  ],
  "concepts": [
    {"id": "skills", "label": "取攻击方命中值和防守方闪避值",
